                {
                  "name": "Set the OIDC SSO configuration",
                  "id": "699d4577-9966-479c-956c-b279e3d483fc",
                  "protocolProfileBehavior": {
                    "disableBodyPruning": true
                  },
                  "request": {
                    "method": "PUT",
                    "header": [
                      {
                        "key": "Content-Type",
                        "value": "application/json"
                      },
                      {
                        "key": "Accept",
                        "value": "application/json"
                      }
                    ],
                    "body": {
                      "mode": "raw",
                      "raw": "{\n  \"clientId\": \"<string>\",\n  \"clientSecret\": \"<string>\",\n  \"discoveryEndpoint\": \"<uri>\",\n  \"loginEnabled\": \"<boolean>\",\n  \"prompt\": \"consent\",\n  \"authenticationContextClassReference\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"additionalScopes\": \"<string>\",\n  \"emailVerifiedRequired\": \"<boolean>\",\n  \"rpInitiatedLogoutEnabled\": \"<boolean>\"\n}",
                      "options": {
                        "raw": {
                          "headerFamily": "json",
                          "language": "json"
                        }
                      }
                    },
                    "url": {
                      "raw": "{{baseUrl}}/settings/sso/oidc",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "settings",
                        "sso",
                        "oidc"
                      ]
                    },
                    "description": "Set the OIDC SSO configuration. The update takes effect exactly as it would from the UI, using the same validation. `clientId`, `clientSecret` and `discoveryEndpoint` are required; submit the redacted client secret sentinel to keep the stored secret unchanged. Requires the `oidc:manage` scope and the OIDC feature to be licensed. The client secret is redacted in the response. When the configuration is managed declaratively (via environment variables), the write is rejected with 409 and no changes are made."
                  },
