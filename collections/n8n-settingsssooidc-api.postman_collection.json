                    "method": "GET",
                    "header": [
                      {
                        "key": "Accept",
                        "value": "application/json"
                      }
                    ],
                    "url": {
                      "raw": "{{baseUrl}}/settings/sso/oidc",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "settings",
                        "sso",
                        "oidc"
                      ]
                    },
                    "description": "Retrieve the current OIDC SSO configuration, including every field exposed in the UI. The client secret is redacted on read and is never echoed back in plaintext. Requires the `oidc:manage` scope and the OIDC feature to be licensed."
                  },
