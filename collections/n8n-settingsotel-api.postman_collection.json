            {
              "name": "Set the OpenTelemetry configuration",
              "id": "9eee9c2f-89f3-4be4-bbb5-a1c5e275c945",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "PUT",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"enabled\": \"<boolean>\",\n  \"exporterEndpoint\": \"<uri>\",\n  \"exporterTracingPath\": \"<string>\",\n  \"exporterServiceName\": \"<string>\",\n  \"exporterHeaders\": \"<string>\",\n  \"tracesSampleRate\": \"<number>\",\n  \"startupConnectivityTimeoutMs\": \"<integer>\",\n  \"includeNodeSpans\": \"<boolean>\",\n  \"injectOutbound\": \"<boolean>\",\n  \"productionExecutionsOnly\": \"<boolean>\"\n}",
