                        "value": "application/json"
                      }
                    ],
                    "url": {
                      "raw": "{{baseUrl}}/settings/sso/saml",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "settings",
                        "sso",
                        "saml"
                      ]
                    },
                    "description": "Retrieve the current SAML SSO configuration, including every field exposed in the UI plus the service provider entity ID and ACS return URL. Signing private keys, signing certificates, and identity provider metadata are redacted on read. Requires the `saml:manage` scope and the SAML feature to be licensed."
