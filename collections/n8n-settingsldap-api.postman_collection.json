            {
              "name": "Set the LDAP configuration",
              "id": "42c6993b-8ee0-4feb-9fff-36e26b1ee3d3",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "PUT",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"loginEnabled\": \"<boolean>\",\n  \"loginLabel\": \"<string>\",\n  \"connectionUrl\": \"<string>\",\n  \"allowUnauthorizedCerts\": \"<boolean>\",\n  \"connectionSecurity\": \"none\",\n  \"connectionPort\": \"<integer>\",\n  \"baseDn\": \"<string>\",\n  \"bindingAdminDn\": \"<string>\",\n  \"bindingAdminPassword\": \"<string>\",\n  \"firstNameAttribute\": \"<string>\",\n  \"lastNameAttribute\": \"<string>\",\n  \"emailAttribute\": \"<string>\",\n  \"loginIdAttribute\": \"<string>\",\n  \"ldapIdAttribute\": \"<string>\",\n  \"userFilter\": \"<string>\",\n  \"synchronizationEnabled\": \"<boolean>\",\n  \"synchronizationInterval\": \"<integer>\",\n  \"searchPageSize\": \"<integer>\",\n  \"searchTimeout\": \"<integer>\",\n  \"enforceEmailUniqueness\": \"<boolean>\"\n}",
                  "options": {
                    "raw": {
                      "headerFamily": "json",
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/settings/ldap",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "settings",
                    "ldap"
                  ]
                },
                "description": "Replace the LDAP configuration with the provided full object (partial updates are not supported). For bindingAdminPassword, submit the blanking placeholder from a prior GET to keep the stored password unchanged. Requires the `ldap:manage` scope and the LDAP feature to be licensed. Setting loginEnabled to false is destructive and it deletes all stored LDAP user identities and disables synchronization."
              },
